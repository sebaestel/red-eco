# URL pública del sitio. En Vercel, defínela como Environment Variable.
NEXT_PUBLIC_SITIO_URL=https://redeco.cl

# Correo que recibe los mensajes del formulario.
CONTACTO_EMAIL_DESTINO=contacto@redeco.cl

# Opcional: si existe, el formulario envía correo con Resend (https://resend.com).
# Si no existe, el formulario sigue funcionando y solo registra el mensaje en los logs.
RESEND_API_KEY=
RESEND_FROM="RED ECO <web@redeco.cl>"
